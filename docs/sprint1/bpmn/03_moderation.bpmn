    <bpmn:startEvent id="M01" name="Новий коментар у черзі">
      <bpmn:outgoing>03_moderation_F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="M01_Message" />
    </bpmn:startEvent>
    <bpmn:startEvent id="M02" name="Скаргу отримано">
      <bpmn:outgoing>03_moderation_F02</bpmn:outgoing>
      <bpmn:messageEventDefinition id="M02_Message" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="M03" name="Звернення отримано" gatewayDirection="Converging">
