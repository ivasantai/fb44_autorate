      <bpmn:outgoing>03_moderation_F16</bpmn:outgoing>
      <bpmn:outgoing>03_moderation_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M13" name="Заблокувати користувача">
      <bpmn:incoming>03_moderation_F18</bpmn:incoming>
      <bpmn:outgoing>03_moderation_F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M15" name="Записати видалення в журнал">
      <bpmn:incoming>03_moderation_F16</bpmn:incoming>
      <bpmn:outgoing>03_moderation_F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M17" name="Схвалено">
      <bpmn:incoming>03_moderation_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="M18" name="Приховано">
      <bpmn:incoming>03_moderation_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="M19" name="Видалено з попередженням">
      <bpmn:incoming>03_moderation_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="M20" name="Користувача заблоковано">
      <bpmn:incoming>03_moderation_F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="M21_Object" />
    <bpmn:dataObjectReference id="M21" name="Коментар або скарга" dataObjectRef="M21_Object" />
    <bpmn:dataStoreReference id="M22" name="Журнал модерації" dataStoreRef="M22_Store" />
    <bpmn:textAnnotation id="M23">
      <bpmn:text>Рішення приймає модератор. Репутація біля коментаря - вимога нової функції US-14.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="M24">
      <bpmn:text>При видаленні надсилається попередження. За повторне порушення користувача блокують.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:task id="M25" name="Записати схвалення в журнал">
      <bpmn:incoming>03_moderation_F12</bpmn:incoming>
