      <bpmn:incoming>03_moderation_F03</bpmn:incoming>
      <bpmn:outgoing>03_moderation_F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M05" name="Прочитати коментар">
      <bpmn:documentation>Модератор читає текст і фіксує одне рішення; M06 лише маршрутизує вже обраний результат.</bpmn:documentation>
      <bpmn:incoming>03_moderation_F04</bpmn:incoming>
      <bpmn:outgoing>03_moderation_F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M06" name="Яке рішення?" gatewayDirection="Diverging">
      <bpmn:incoming>03_moderation_F05</bpmn:incoming>
      <bpmn:outgoing>03_moderation_F09</bpmn:outgoing>
      <bpmn:outgoing>03_moderation_F10</bpmn:outgoing>
      <bpmn:outgoing>03_moderation_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M07" name="Схвалити коментар">
      <bpmn:incoming>03_moderation_F09</bpmn:incoming>
      <bpmn:outgoing>03_moderation_F12</bpmn:outgoing>
    </bpmn:task>
