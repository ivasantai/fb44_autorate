      <bpmn:incoming>03_moderation_F10</bpmn:incoming>
      <bpmn:outgoing>03_moderation_F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M09" name="Видалити коментар">
      <bpmn:outgoing>03_moderation_F06</bpmn:outgoing>
      <bpmn:incoming>03_moderation_F11</bpmn:incoming>
    </bpmn:task>
    <bpmn:sendTask id="M10" name="Надіслати попередження користувачу">
      <bpmn:incoming>03_moderation_F06</bpmn:incoming>
      <bpmn:outgoing>03_moderation_F07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="M11" name="Перевірити повторність порушення">
