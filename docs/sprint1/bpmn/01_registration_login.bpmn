    <bpmn:task id="R20" name="Перевірити облікові дані і ліміт спроб">
      <bpmn:incoming>01_registration_login_F16</bpmn:incoming>
      <bpmn:outgoing>01_registration_login_F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="R21" name="Результат перевірки входу?" gatewayDirection="Diverging">
      <bpmn:documentation>R20 повертає рівно один результат: Успішно, Відмова або Блокування. Відмова означає невірні дані без чинного блокування; Блокування означає чинну заборону або досягнутий ліміт спроб.</bpmn:documentation>
      <bpmn:incoming>01_registration_login_F17</bpmn:incoming>
      <bpmn:outgoing>01_registration_login_F26</bpmn:outgoing>
      <bpmn:outgoing>01_registration_login_F27</bpmn:outgoing>
      <bpmn:outgoing>01_registration_login_F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="R22" name="Відкрити сесію і показати профіль">
      <bpmn:outgoing>01_registration_login_F18</bpmn:outgoing>
      <bpmn:incoming>01_registration_login_F26</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="R23" name="Сесію відкрито">
      <bpmn:incoming>01_registration_login_F18</bpmn:incoming>
      <bpmn:messageEventDefinition id="R23_Message" />
    </bpmn:endEvent>
