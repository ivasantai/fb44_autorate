    </bpmn:endEvent>
    <bpmn:endEvent id="R25" name="Невірні облікові дані">
      <bpmn:incoming>01_registration_login_F27</bpmn:incoming>
      <bpmn:messageEventDefinition id="R25_Message" />
    </bpmn:endEvent>
    <bpmn:task id="R26" name="Зберегти строк блокування">
      <bpmn:outgoing>01_registration_login_F19</bpmn:outgoing>
      <bpmn:incoming>01_registration_login_F28</bpmn:incoming>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="R27" name="Блокування повідомлено">
      <bpmn:incoming>01_registration_login_F19</bpmn:incoming>
      <bpmn:outgoing>01_registration_login_F20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="R27_Message" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="R28" name="Строк блокування минув">
      <bpmn:incoming>01_registration_login_F20</bpmn:incoming>
      <bpmn:outgoing>01_registration_login_F21</bpmn:outgoing>
      <bpmn:timerEventDefinition id="R28_Timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">blockedUntil</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="R29" name="Зняти блокування входу">
      <bpmn:incoming>01_registration_login_F21</bpmn:incoming>
      <bpmn:outgoing>01_registration_login_F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="R30" name="Вхід знову дозволено">
      <bpmn:incoming>01_registration_login_F22</bpmn:incoming>
    </bpmn:endEvent>
