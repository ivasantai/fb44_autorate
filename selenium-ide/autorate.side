        },
        {
          "id": "50ba4af6-b812-4e3c-a303-ec4c3c202e21",
          "comment": "м'яка: кнопки Vote! немає",
          "command": "verifyElementNotPresent",
          "target": "xpath=//button[normalize-space()='Vote!']",
          "targets": [],
          "value": ""
        }
      ]
    },
